APP_ENV=development
APP_NAME=HarnessLab
LOG_LEVEL=info

# Provider-neutral analysis gateway. Deterministic is the safe default.
# Allowed values: deterministic, ollama, openrouter.
HARNESSLAB_GATEWAY_HOST=127.0.0.1
HARNESSLAB_GATEWAY_PORT=8787
HARNESSLAB_PROVIDER=deterministic
HARNESSLAB_GATEWAY_TIMEOUT_MS=45000
HARNESSLAB_HEALTH_TIMEOUT_MS=3000
HARNESSLAB_MAX_BODY_BYTES=65536
HARNESSLAB_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,https://yashumani.github.io

# First executable temporary worker: one architecture critic, one provider call, no tools.
HARNESSLAB_CRITIC_TIMEOUT_MS=20000
HARNESSLAB_CRITIC_MAX_BODY_BYTES=262144

# Used only when HARNESSLAB_PROVIDER=ollama. Keep provider configuration server-side.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=

# Used only when HARNESSLAB_PROVIDER=openrouter.
# A free OpenRouter account/API key is still required. The key stays in the gateway environment.
# HarnessLab accepts only openrouter/free or an explicit model identifier ending in :free.
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=https://yashumani.github.io/harnesslab/
OPENROUTER_APP_TITLE=HarnessLab

# Future persistence and queue services; not used by the current static workspace slice.
DATABASE_URL=postgresql://harnesslab:harnesslab@localhost:5432/harnesslab
REDIS_URL=redis://localhost:6379/0

MAX_SUBAGENTS=4
MAX_SUBAGENT_DEPTH=1
MAX_PARALLEL_TASKS=3
MAX_MODEL_CALLS_PER_RUN=20
DEFAULT_TASK_TIMEOUT_SECONDS=120

# Never place real credentials in this file. Copy it to .env locally.
